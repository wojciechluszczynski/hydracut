---
/**
 * Rysunkowy zestaw ikon. Ta sama kreska co schemat rury w hero: hairline,
 * bez wypełnień, bez dekoracyjnych zaokrągleń. Żadnej biblioteki.
 */
interface Props {
  name: 'rura' | 'wcinka' | 'awaria' | 'kolektor' | 'demontaz' | 'cieplo';
  class?: string;
}
const { name, class: cls } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  class:list={['ico', cls]}
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
>
  {
    name === 'rura' && (
      <>
        {/* wymiana odcinka: rura przecięta w dwóch miejscach */}
        <path d="M3 18 H16 M32 18 H45" />
        <path d="M3 30 H16 M32 30 H45" />
        <ellipse cx="16" cy="24" rx="2.6" ry="6" class="ico__a" />
        <ellipse cx="32" cy="24" rx="2.6" ry="6" class="ico__a" />
        <path d="M18.6 18 H29.4 M18.6 30 H29.4" stroke-dasharray="3 3" stroke-opacity="0.45" />
      </>
    )
  }
  {
    name === 'wcinka' && (
      <>
        {/* wcinka: magistrala z odejściem i kołnierzem */}
        <path d="M3 30 H45" />
        <path d="M3 40 H45" stroke-opacity="0.45" />
        <path d="M24 30 V14" class="ico__a" />
        <path d="M18 14 H30" class="ico__a" />
        <path d="M20 10 V14 M28 10 V14" stroke-opacity="0.5" />
      </>
    )
  }
  {
    name === 'awaria' && (
      <>
        {/* awaria: rura i wyciekająca woda */}
        <path d="M4 14 H44" />
        <path d="M4 26 H44" />
        <path d="M24 26 v6" class="ico__a" />
        <path d="M20 36 a4 5 0 0 0 8 0 a12 12 0 0 0 -4 -6 a12 12 0 0 0 -4 6 z" class="ico__a" />
      </>
    )
  }
  {
    name === 'kolektor' && (
      <>
        {/* kolektor: rura wielkiej średnicy w przekroju */}
        <circle cx="24" cy="24" r="16" />
        <circle cx="24" cy="24" r="11" stroke-opacity="0.45" />
        <path d="M24 8 V13 M24 35 V40 M8 24 H13 M35 24 H40" class="ico__a" />
      </>
    )
  }
  {
    name === 'demontaz' && (
      <>
        {/* rozbiórka: rura pocięta na odcinki */}
        <path d="M4 18 H44 M4 30 H44" />
        <path d="M17 16 V32" class="ico__a" />
        <path d="M31 16 V32" class="ico__a" />
        <path d="M9 22 h4 M22 22 h4 M36 22 h4" stroke-opacity="0.3" />
      </>
    )
  }
  {
    name === 'cieplo' && (
      <>
        {/* ciepłownictwo: rura preizolowana, warstwy */}
        <circle cx="24" cy="24" r="15" stroke-opacity="0.4" />
        <circle cx="24" cy="24" r="10" stroke-opacity="0.7" />
        <circle cx="24" cy="24" r="5" class="ico__a" />
        <path d="M24 3 v4 M24 41 v4" stroke-opacity="0.35" />
      </>
    )
  }
</svg>

<style>
  .ico {
    width: 44px;
    height: 44px;
    color: var(--muted);
    stroke-linecap: square;
    stroke-linejoin: miter;
  }
  .ico__a { stroke: var(--accent-text); }
</style>
