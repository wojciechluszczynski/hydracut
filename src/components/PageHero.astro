---
import Plane from './Plane.astro';
import Figure from './Figure.astro';

interface Props {
  h1: string;
  lead?: string;
  crumbs: { label: string; href: string }[];
  /** Litera płaszczyzny dla nagłówka podstrony. Domyślnie "P" jak podstrona. */
  mark?: string;
  /** Wpis z site.media. Renderuje się we własnych proporcjach, bez kadrowania. */
  photo?: { src: string; alt: string; w: number; h: number };
}
const { h1, lead, crumbs, mark = 'P', photo } = Astro.props;
const label = crumbs.at(-1)?.label ?? '';
---

{/* Nagłówek podstrony niesie to samo wywołanie przekroju, co sekcje na
    stronie głównej. Bez tego podstrony wracały do zwykłego stosu bloków. */}
<section class="phero">
  <div class="cut">
    <nav class="phero__crumbs mono" aria-label="Okruszki">
      <a href="/">Strona główna</a>
      {
        crumbs.map((c, i) => (
          <>
            <span aria-hidden="true">/</span>
            {i === crumbs.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}
          </>
        ))
      }
    </nav>

    <Plane mark={mark} label={label} />

    <h1 class="display-xl">
      {h1.split('\n').map((line, i) => (
        <>
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </h1>

    {lead && <p class="lead muted phero__lead">{lead}</p>}

    {photo && <Figure {...photo} id={mark} caption={photo.alt} priority class="phero__fig" />}
  </div>
</section>

<style>
  .phero {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--rule);
  }
  .phero__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }
  .phero__crumbs a:hover { color: var(--accent-text); }
  .phero__crumbs [aria-current] { color: var(--fg); }
  .phero__lead { margin-top: 1.75rem; }
  .phero__fig { margin-top: clamp(2rem, 4vw, 3rem); }
</style>
