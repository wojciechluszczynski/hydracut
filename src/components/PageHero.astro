---
interface Props {
  h1: string;
  lead?: string;
  crumbs: { label: string; href: string }[];
  /** Zdjęcie kontekstowe pod nagłówkiem. Pas 21:9, ładowany priorytetowo, bo jest LCP. */
  image?: string;
  imageAlt?: string;
}
const { h1, lead, crumbs, image, imageAlt } = Astro.props;
---

<section class="phero">
  <div class="shell">
    <nav class="phero__crumbs mono" aria-label="Okruszki">
      <a href="/">Strona główna</a>
      {
        crumbs.map((c, i) => (
          <>
            <span aria-hidden="true">/</span>
            {i === crumbs.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}
          </>
        ))
      }
    </nav>

    <h1 class="display-xl">
      {h1.split('\n').map((line, i) => (
        <>
          {i > 0 && <br />}
          {line}
        </>
      ))}
    </h1>

    {lead && <p class="lead muted phero__lead">{lead}</p>}
  </div>

  {
    image && (
      <div class="shell">
        <img
          src={image}
          srcset={`${image.replace('.webp', '-800.webp')} 800w, ${image} 1600w`}
          sizes="(max-width: 900px) 100vw, 1320px"
          alt={imageAlt ?? ''}
          width="1800"
          height="771"
          fetchpriority="high"
          decoding="async"
          class="phero__img"
        />
      </div>
    )
  }
</section>

<style>
  .phero {
    padding-block: clamp(2.5rem, 5vw, 4.5rem) clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: 1px solid var(--rule);
  }
  .phero__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .phero__crumbs a:hover { color: var(--accent-text); }
  .phero__crumbs [aria-current] { color: var(--fg); }
  .phero__lead { margin-top: 1.75rem; }
  .phero__img {
    display: block;
    width: 100%;
    height: clamp(180px, 26vw, 340px);
    object-fit: cover;
    margin-top: clamp(2rem, 4vw, 3rem);
    border: 1px solid var(--rule);
    filter: saturate(0.85) contrast(1.05);
  }
</style>
