---
/** Dark is the default. The toggle stores an explicit choice; without one the
    site follows the operating system setting. */
---

<button class="tgl" type="button" aria-pressed="false" title="Przełącz tryb jasny i ciemny">
  <span class="sr-only">Przełącz tryb jasny i ciemny</span>
  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
    <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="M10 2.75 A7.25 7.25 0 0 1 10 17.25 Z" fill="currentColor"></path>
  </svg>
</button>

<style>
  .tgl {
    display: inline-grid;
    place-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: none;
    color: var(--fg);
    cursor: pointer;
    transition: border-color 150ms ease, color 150ms ease;
    flex: none;
  }
  .tgl:hover { border-color: var(--accent-text); color: var(--accent-text); }
  .tgl svg { transition: transform 300ms ease; }
  :global(:root[data-theme='light']) .tgl svg { transform: rotate(180deg); }
</style>

<script>
  const root = document.documentElement;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  const paint = (theme: string) => {
    root.dataset.theme = theme;
    if (meta) meta.content = theme === 'light' ? '#faf9f6' : '#0b0c0e';
    document.querySelectorAll<HTMLButtonElement>('.tgl').forEach((b) => {
      b.setAttribute('aria-pressed', String(theme === 'light'));
    });
  };

  document.querySelectorAll<HTMLButtonElement>('.tgl').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      localStorage.setItem('hc-theme', next);
      paint(next);
    });
  });

  paint(root.dataset.theme || 'dark');
</script>
