---
import { ui } from '../lib/i18n';
import { splitTbd } from '../lib/val';

interface Props {
  text: string;
  class?: string;
}

const { text, class: cls } = Astro.props;
const { text: value, tbd } = splitTbd(text);
---

{
  tbd ? (
    <span class:list={['tbd', cls]} title={ui("unconfirmed")}>
      {value}
    </span>
  ) : (
    <span class:list={[cls]}>{value}</span>
  )
}
