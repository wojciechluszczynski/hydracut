---
/**
 * Promo film slot. Empty youtubeId renders the reserved frame.
 * With an id it renders a click-to-load facade: no iframe, no YouTube
 * request and no cookie until the visitor presses play.
 */
interface Props {
  youtubeId?: string;
  /** Lokalny plik mp4. Używany, dopóki nie ma filmu promocyjnego na YouTube. */
  file?: string;
  poster?: string;
  caption: string;
  title: string;
}
const { youtubeId = '', file = '', poster = '', caption, title } = Astro.props;
---

{
  youtubeId ? (
    <div class="vid" data-yt={youtubeId} data-title={title}>
      <button class="vid__play" type="button" aria-label={`Odtwórz film: ${title}`}>
        <img
          src={`https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`}
          alt=""
          loading="lazy"
          width="1280"
          height="720"
        />
        <span class="vid__tri" aria-hidden="true" />
      </button>
      <p class="vid__cap mono">{caption}</p>
    </div>
  ) : file ? (
    <figure class="vid">
      <video
        class="vid__local"
        src={file}
        poster={poster}
        controls
        muted
        loop
        playsinline
        preload="none"
        aria-label={title}
      />
      <figcaption class="vid__cap mono">{caption}</figcaption>
    </figure>
  ) : (
    <figure class="vid vid--empty">
      <div class="vid__frame">
        <span class="vid__tri vid__tri--ghost" aria-hidden="true" />
        <span class="vid__soon mono">Film promocyjny &middot; wkrótce</span>
      </div>
      <figcaption class="vid__cap mono">{caption}</figcaption>
    </figure>
  )
}

<style>
  .vid { margin: 0; }
  .vid__frame,
  .vid__play {
    position: relative;
    display: grid;
    place-items: center;
    gap: 1rem;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--rule);
    background:
      repeating-linear-gradient(135deg, transparent 0 10px, rgba(255, 255, 255, 0.022) 10px 11px),
      var(--elev);
    padding: 0;
    cursor: pointer;
  }
  .vid__local {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--rule);
    background: var(--elev);
  }
  .vid__play img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vid__tri {
    position: relative;
    width: 0;
    height: 0;
    border-left: 26px solid var(--color-amber);
    border-top: 16px solid transparent;
    border-bottom: 16px solid transparent;
  }
  .vid__tri--ghost { border-left-color: transparent; }
  .vid__tri--ghost::before {
    content: '';
    position: absolute;
    left: -26px;
    top: -16px;
    width: 0;
    height: 0;
    border-left: 26px solid transparent;
    border-top: 16px solid transparent;
    border-bottom: 16px solid transparent;
    box-sizing: border-box;
  }
  .vid--empty .vid__tri {
    border-left: 0;
    width: 26px;
    height: 32px;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
    background: none;
    outline: 1px solid var(--color-amber);
    outline-offset: -1px;
  }
  .vid__soon {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .vid__cap {
    margin-top: 0.85rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .vid iframe { width: 100%; aspect-ratio: 16/9; border: 1px solid var(--rule); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.vid[data-yt]').forEach((wrap) => {
    const btn = wrap.querySelector('.vid__play');
    btn?.addEventListener('click', () => {
      const id = wrap.dataset.yt;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      frame.title = wrap.dataset.title ?? 'Film';
      frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture';
      frame.allowFullscreen = true;
      btn.replaceWith(frame);
    });
  });
</script>
