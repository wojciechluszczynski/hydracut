---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NextLinks from '../components/NextLinks.astro';
import Plane from '../components/Plane.astro';
import VideoSlot from '../components/VideoSlot.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Val from '../components/Val.astro';
import { site } from '../data/site';

const p = site.pages.how;
const crumbs = [{ label: 'Jak to działa', href: '/jak-to-dziala/' }];

const schema = [
  {
    '@type': 'HowTo',
    name: 'Cięcie rury po obwodzie w wykopie',
    description: p.description,
    totalTime: 'PT30M',
    tool: [{ '@type': 'HowToTool', name: site.meta.model }],
    step: site.how.steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.title,
      text: s.body,
    })),
  },
];
---

<Base title={p.title} description={p.description} crumbs={crumbs} schema={schema}>
  <PageHero h1={p.h1} lead={p.lead} crumbs={crumbs}
    photo={site.media.machine}
  mark="J"
  />

  <section class="band">
    <div class="cut">
      <Plane mark="A" label="Przebieg pracy" />
      <ol class="steps">
        {
          site.how.steps.map((step, i) => (
            <li class="step reveal">
              <span class="step__idx mono">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h2 class="step__title">{step.title}</h2>
                <p class="muted">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="film">
        <VideoSlot
          youtubeId={site.how.video.youtubeId}
          caption={site.how.video.caption}
          title={site.how.video.title}
        />
      </div>
    </div>
  </section>

  <section class="band band--paper">
    <div class="cut safety">
      <div>
        <Plane mark="B" label="Bezpieczeństwo" />
        <h2 class="display-l">{p.safety.h2}</h2>
        <PhotoSlot {...site.photos.edge} class="safety__photo" />
      </div>
      <ul class="safety__list">
        {
          p.safety.items.map((item) => (
            <li class="reveal">
              <Val text={item} />
            </li>
          ))
        }
      </ul>
    </div>

    <div class="cut">
      <NextLinks
        items={[
          {
            label: 'Dane techniczne',
            href: '/dane-techniczne/',
            note: 'Pełna specyfikacja maszyny w konfiguracji standardowej.',
          },
          { label: 'Zastosowania', href: '/zastosowania/', note: 'Gdzie ta metoda cięcia daje najwięcej oszczędności.' },
          { label: 'Zapytaj o cenę', href: '/kontakt/', note: 'Odpowiadamy w ciągu jednego dnia roboczego.' },
        ]}
      />
    </div>
  </section>
</Base>

<style>
  .steps { list-style: none; display: grid; gap: 0; border-top: 1px solid var(--rule); }
  .step {
    display: grid;
    gap: 1rem;
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--rule);
  }
  .step__idx { font-size: 0.75rem; color: var(--accent-text); letter-spacing: 0.2em; }
  .step__title { font-size: clamp(1.25rem, 2vw, 1.625rem); margin-bottom: 0.75rem; }
  .step p { max-width: 62ch; font-size: 0.9375rem; }
  @media (min-width: 780px) {
    .step { grid-template-columns: 5rem minmax(0, 1fr); gap: 2.5rem; align-items: baseline; }
  }
  .film { margin-top: clamp(3rem, 5vw, 4.5rem); max-width: 980px; }

  .safety { display: grid; gap: 3rem; }
  .safety__photo { margin-top: 2rem; max-width: 380px; }
  .safety__list { list-style: none; display: grid; gap: 0; border-top: 1px solid var(--rule); }
  .safety__list li {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
    max-width: 60ch;
    position: relative;
    padding-left: 1.75rem;
  }
  .safety__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.5rem;
    width: 8px;
    height: 8px;
    background: var(--color-amber);
  }
  @media (min-width: 900px) {
    .safety { grid-template-columns: 1fr 1.2fr; gap: 4.5rem; align-items: start; }
  }
</style>
